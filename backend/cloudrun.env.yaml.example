# Copy to cloudrun.env.yaml, fill in secrets, and pass with --env-vars-file.
# (cloudrun.env.yaml is gitignored — never commit real keys.)
# A YAML file avoids the comma-escaping pain of --set-env-vars, which matters
# because GOOGLE_SERVICE_ACCOUNT_JSON is a comma-heavy blob.
MOCK_MODE: "0"
DEMO_FALLBACK: "0"
GEMINI_API_KEY: "your-gemini-key"
SUPABASE_URL: "https://xxxx.supabase.co"
SUPABASE_SERVICE_KEY: "your-service-key"
DRIVE_PARENT_FOLDER_ID: "your-folder-id"
GOOGLE_SERVICE_ACCOUNT_JSON: '{"type":"service_account", ... }'
ALLOWED_ORIGINS: "*"
LANGFUSE_ENABLED: "0"
# Set this to the Cloud Run URL AFTER the first deploy prints it, then redeploy:
PUBLIC_BASE_URL: "https://photodukaan-api-XXXX.a.run.app"
