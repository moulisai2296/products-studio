# --- Core modes -----------------------------------------------------------
MOCK_MODE=1                      # 1 = zero external deps (safe demo default); 0 = real APIs
DEMO_FALLBACK=0                  # 1 = always serve seed/ assets (venue network-death insurance)

# --- Gemini ---------------------------------------------------------------
GEMINI_API_KEY=

# --- Supabase (persistence) ----------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# ONE of these is needed ONLY to create tables via setup_db.py (not at runtime):
SUPABASE_DB_PASSWORD=            # DB password (Dashboard > Settings > Database)
# SUPABASE_DB_URL=postgresql://postgres:PASS@db.<ref>.supabase.co:5432/postgres

# --- Google Drive (background nicety) ------------------------------------
DRIVE_PARENT_FOLDER_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=     # inline JSON OR a path to the service-account file

# --- Langfuse (observability) --------------------------------------------
LANGFUSE_ENABLED=0               # 1 to turn on tracing
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Deploy / URLs --------------------------------------------------------
PUBLIC_BASE_URL=http://localhost:8000   # public URL this backend is reachable at
ALLOWED_ORIGINS=*                       # CORS; set to your Vercel URL in prod
# PORT is provided by Render automatically
